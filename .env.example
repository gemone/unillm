# unillm-proxy environment template (`DESIGN.md` §14.1).
# Copy to `.env` and fill in — `scripts/init.sh` does this for you with generated secrets.
# `.env` is gitignored; never commit real secrets.

# --- secrets (generate with `openssl rand -hex N`) ---
UNILLM_KEY_PEPPER=                          # pepper mixed into virtual-key hashes (REQUIRED in prod)
UNILLM_ADMIN_TOKEN=                         # gates /admin/* (distinct from data-plane keys)
UNILLM_SEED_KEY=                            # a dev data-plane key seeded on first boot (optional)

# --- upstream providers: set the key for each provider you want enabled ---
# Only providers with a key set get a backend client (/ready is 200 once ≥1 is configured).
UNILLM_PROV_OPENAI_KEY=
UNILLM_PROV_ANTHROPIC_KEY=
UNILLM_PROV_OPENROUTER_KEY=
UNILLM_PROV_DEEPSEEK_KEY=
# Optional base-URL overrides (e.g. an OpenAI-compatible gateway / Azure / self-hosted):
# UNILLM_PROV_OPENAI_BASE_URL=https://api.openai.com/v1
# UNILLM_PROV_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# --- storage ---
UNILLM_DATABASE_URL=sqlite://./unillm.db    # or postgres://unillm:unillm@localhost:5432/unillm

# --- response cache (§7.4) ---
UNILLM_CACHE_ENABLED=false                  # exact-hash response cache (opt-in)
UNILLM_CACHE_TTL=300                        # cache TTL (seconds)

# --- runtime ---
UNILLM_PROXY_BIND=0.0.0.0:8080              # listen address
RUST_LOG=info
